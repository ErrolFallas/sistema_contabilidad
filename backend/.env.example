# ============================================================
# DocScan Finance CR - Backend .env
# Copiar como .env y completar valores reales.
# NUNCA versionar el archivo .env real.
# ============================================================

# === Servidor ===
NODE_ENV=development
PORT=3000

# === Logging ===
# Niveles: trace, debug, info, warn, error, fatal, silent.
# Default por NODE_ENV: development -> debug, production -> info.
LOG_LEVEL=

# === IA (Gemini - Google AI Studio, tier gratuito) ===
# Obtener en: https://aistudio.google.com/app/apikey
# Modelos usados:
#   - GEMINI_MODEL (chat / extraccion): gemini-2.5-flash
#   - Embeddings (busqueda inteligente): gemini-embedding-001 (constante en codigo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Google OAuth (Drive + Gmail) ===
# Crear en: https://console.cloud.google.com/apis/credentials
# Scopes: drive + gmail.modify + openid + email + profile
# El refresh token se persiste en MySQL (tabla google_credentials) tras el
# flujo OAuth desde la UI; NO se carga desde aqui.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# === Carpetas Google Drive ===
DRIVE_ROOT_FOLDER_NAME=DocScanFinanceCR
DRIVE_SUBFOLDERS=Facturas,Procesadas,Errores,PlantillasExcel,OCR,Temporal

# === MySQL nativo Windows ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME=docscan_finance
DB_CONNECTION_LIMIT=10

# === JWT ===
# JWT_SECRET es OBLIGATORIO. Genere uno aleatorio largo (>=32 chars).
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=
JWT_EXPIRES_IN=8h

# === Bootstrap admin (solo primer arranque) ===
# Cambie la password despues del primer login desde la UI ("Mi cuenta").
BOOTSTRAP_ADMIN_EMAIL=admin@docscan.local
BOOTSTRAP_ADMIN_PASSWORD=

# === n8n callback ===
BACKEND_BASE_URL=http://localhost:3000
# N8N_INGEST_TOKEN es OBLIGATORIO. Genere uno aleatorio largo distinto al JWT_SECRET.
# Tambien debe pegarse en cada workflow JSON al importarlos en n8n
# (header X-N8N-Token de los nodos HTTP Request).
N8N_INGEST_TOKEN=

# === BCCR (tipo de cambio diario USD) ===
BCCR_INDICADOR_VENTA=318
BCCR_INDICADOR_COMPRA=317

# === Almacenamiento local ===
STORAGE_DIR=./storage
EXCEL_TEMPLATE_REINTEGRO=./templates/Reintegro.xlsx
