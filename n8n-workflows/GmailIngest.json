{
  "name": "GmailIngest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 40
            }
          ]
        }
      },
      "id": "trigger-gmail",
      "name": "Schedule (40s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/integrations/poll-gmail",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Token",
              "value": "REEMPLAZAR_CON_N8N_INGEST_TOKEN_DE_BACKEND_ENV"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "http-gmail-poll",
      "name": "POST /api/integrations/poll-gmail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    }
  ],
  "connections": {
    "Schedule (40s)": {
      "main": [
        [
          {
            "node": "POST /api/integrations/poll-gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "DocScanFinanceCR"
    }
  ]
}
